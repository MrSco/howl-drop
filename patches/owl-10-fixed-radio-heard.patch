+	/* -F -H: we only ever hear a peer on our channel, so one heard a moment
+	 * ago is there now. That is when a reply to it is produced (a SYN-ACK, a
+	 * TLS flight, an mDNS answer), and it can leave at once instead of
+	 * waiting for the slot our clock says is the peer's. With an iPhone on
+	 * our channel one slot in sixteen, being one slot off there sent every
+	 * held frame while the phone was away (8260, 2026-10-12: five copies of
+	 * each mDNS answer, none heard). The sequence below still gates frames
+	 * nobody is waiting on. */
+	if (state->channel.fixed_radio && state->channel.heard_window_us
+	    && now >= peer->last_update && now - peer->last_update < state->channel.heard_window_us)
+		return true;
+
