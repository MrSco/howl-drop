diff --git a/daemon/core.c b/daemon/core.c
index 214c80d..ebfe931 100644
--- a/daemon/core.c
+++ b/daemon/core.c
@@ -160,6 +160,19 @@ int awdl_send_data(const struct buf *buf, const struct io_state *io_state,
 	int err = wlan_send(io_state, awdl_data, awdl_data_len);
 	if (err == -EAGAIN)
 		return TX_AGAIN;
+	/* -F -U: unicast goes out without an ACK (owl-05), so a frame the peer
+	 * misses waits for TCP and the peer's next visit, a whole period away
+	 * when it visits our channel one slot in sixteen. Copies sent now, while
+	 * the gate is open, give the frame more than one chance in this visit.
+	 * The peer drops the extras as duplicates (802.11 or TCP). A copy the
+	 * queue refuses is skipped: the first one went. */
+	if (!err && awdl_state->channel.fixed_radio && !(dst.ether_addr_octet[0] & 1)) {
+		for (int i = 1; i < awdl_unicast_copies; i++) {
+			if (wlan_send(io_state, awdl_data, awdl_data_len) < 0)
+				break;
+			awdl_state->stats.tx_data++;
+		}
+	}
 	awdl_state->stats.tx_data++;
 	if (err < 0)
 		return TX_FAIL;
